---
import CommentIsland from '../../islands/CommentIsland.vue'
import RecentCommentsIsland from '../../islands/RecentCommentsIsland.vue'
import { config } from '../../lib/config'
import { messagesFor } from '../../lib/i18n'

export function getStaticPaths() {
  return process.env.ASTRO_PREFLIGHT_TESTS === 'true' ? ['comments', 'cloudbase', 'twikoo-highlight', 'twikoo-interactions', 'provider-valine', 'provider-waline', 'provider-giscus', 'provider-none'].map((suite) => ({ params: { suite } })) : []
}
const labels = messagesFor('en')
const identity = { legacyUid: 'preflight-legacy-uid', canonicalPath: '/post/preflight/', legacyPath: '/post/preflight/' }
const providerSettings = {
  giscus: { repo: 'example/comments', repoId: 'R_test', category: 'General', categoryId: 'DIC_test', mapping: 'pathname', term: '', strict: false, reactionsEnabled: true, emitMetadata: false, inputPosition: 'bottom', theme: 'auto', lang: 'auto', loading: 'eager' },
  giscusSpecific: { repo: 'example/comments', repoId: 'R_test', category: 'General', categoryId: 'DIC_test', mapping: 'specific', term: '{legacyUid}', strict: false, reactionsEnabled: true, emitMetadata: false, inputPosition: 'bottom', theme: 'auto', lang: 'auto', loading: 'eager' },
  giscusUnsafeTerm: { repo: 'example/comments', repoId: 'R_test', category: 'General', categoryId: 'DIC_test', mapping: 'specific', term: '<img src=x onerror=alert(1)>', strict: false, reactionsEnabled: true, emitMetadata: false, inputPosition: 'bottom', theme: 'auto', lang: 'auto', loading: 'eager' },
  valine: { appId: 'preflight-app-id', appKey: 'preflight-public-app-key', avatar: 'mp', placeholder: 'Mock', visitor: false, avatarForce: false, meta: ['nick'], requiredFields: ['nick'] },
  twikoo: { envId: 'https://twikoo.example', region: '', language: 'en' },
  twikooCloud: { envId: 'preflight-cloudbase-env', region: '', language: 'en' },
  waline: { serverUrl: 'https://waline.example', language: 'en', reaction: false, login: 'disable', meta: ['nick'], requiredMeta: ['nick'], commentSorting: 'latest', wordLimit: 0, pageSize: 10 },
  walineReaction: { serverUrl: 'https://waline.example', language: 'en', reaction: true, login: 'disable', meta: ['nick'], requiredMeta: ['nick'], commentSorting: 'latest', wordLimit: 0, pageSize: 10 },
}
const providerLabels = { loading: labels.commentLoading, setupMissing: labels.commentSetupMissing, loadError: labels.commentLoadError }
const recentSettings = { twikoo: config.comments.twikoo, waline: config.comments.waline }
---
<html lang="en">
  <head><meta charset="utf-8" /><title>Preflight provider mocks</title></head>
  <body>
    <main>
      <h1>Preflight provider mocks</h1>
      {Astro.params.suite === 'cloudbase' ? <div data-provider-test="twikoo-cloudbase"><CommentIsland client:load provider="twikoo" {...identity} title="Preflight Twikoo CloudBase" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.twikooCloud} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div> : Astro.params.suite === 'twikoo-highlight' || Astro.params.suite === 'twikoo-interactions' ? <div data-provider-test="twikoo"><CommentIsland client:load provider="twikoo" {...identity} title="Preflight Twikoo Highlight" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.twikoo} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div> : Astro.params.suite === 'provider-valine' ? <div data-provider-test="valine"><CommentIsland client:load provider="valine" {...identity} title="Preflight Valine" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.valine} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div> : Astro.params.suite === 'provider-waline' ? <div data-provider-test="waline"><CommentIsland client:load provider="waline" {...identity} title="Preflight Waline" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.walineReaction} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div> : Astro.params.suite === 'provider-giscus' ? <div data-provider-test="giscus"><CommentIsland client:load provider="giscus" {...identity} title="Preflight giscus" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.giscus} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div> : Astro.params.suite === 'provider-none' ? <p>No provider</p> : <>
      <div data-provider-test="giscus"><CommentIsland client:load provider="giscus" {...identity} title="Preflight giscus" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.giscus} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>
      <div data-provider-test="giscus-zh"><CommentIsland client:load provider="giscus" {...identity} title="预检 giscus" locale="zh-CN" cdnMode={config.siteMeta.cdn} settings={providerSettings.giscus} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>
      <div data-provider-test="giscus-specific"><CommentIsland client:load provider="giscus" {...identity} title="Preflight stable term" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.giscusSpecific} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>
      <div data-provider-test="giscus-escaped-term"><CommentIsland client:load provider="giscus" {...identity} title="Preflight escaped term" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.giscusUnsafeTerm} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>
      <div data-provider-test="valine"><CommentIsland client:load provider="valine" {...identity} title="Preflight Valine" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.valine} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>
      <div data-provider-test="twikoo"><CommentIsland client:load provider="twikoo" {...identity} title="Preflight Twikoo" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.twikoo} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>
      {config.siteMeta.cdn === 'cn' && <div data-provider-test="twikoo-cloudbase"><CommentIsland client:load provider="twikoo" {...identity} title="Preflight Twikoo CloudBase" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.twikooCloud} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>}
      <div data-provider-test="waline"><CommentIsland client:load provider="waline" {...identity} title="Preflight Waline" locale="en" cdnMode={config.siteMeta.cdn} settings={providerSettings.walineReaction} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>
      <div data-provider-test="incomplete"><CommentIsland client:load provider="waline" {...identity} title="Incomplete Waline" locale="en" cdnMode={config.siteMeta.cdn} settings={{ serverUrl: '' }} labels={providerLabels} noScriptText={labels.commentsRequireJavaScript} /></div>
      <section aria-label="Twikoo recent comments"><RecentCommentsIsland client:load provider="twikoo" settings={recentSettings} count={3} base={import.meta.env.BASE_URL} siteOrigin={config.site.url} locale="en" cdnMode={config.siteMeta.cdn} emptyText={labels.noRecentComments} loadingText={labels.recentCommentsLoading} errorText={labels.recentCommentsLoadError} /></section>
      <section aria-label="Waline recent comments"><RecentCommentsIsland client:load provider="waline" settings={recentSettings} count={3} base={import.meta.env.BASE_URL} siteOrigin={config.site.url} locale="en" cdnMode={config.siteMeta.cdn} emptyText={labels.noRecentComments} loadingText={labels.recentCommentsLoading} errorText={labels.recentCommentsLoadError} /></section>
      </>}
    </main>
  </body>
</html>
